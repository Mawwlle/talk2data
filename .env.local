# Модель для распознавания речи (Whisper)
STT_MODEL=medium

# Модель для LLM (vLLM / Hugging Face)
LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
TRANSFORMERS_CACHE=./cache/huggingface
HF_HOME=./cache/huggingface

# Модель для синтеза речи (TTS)
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC

# Голос для синтеза (если модель поддерживает)
TTS_SPEAKER=ljspeech
